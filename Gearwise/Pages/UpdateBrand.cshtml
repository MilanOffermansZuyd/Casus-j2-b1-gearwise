@page
@model Gearwise.Pages.UpdateBrandModel
@{
}
<form method="post">
    <input type="hidden" id="brandId" name="id"  value="@Model.Brand.BrandId"/>
    <label for="brandName">brand name:</label>
    <input type="text" id="brandName" name="name" value="@Model.Brand.Name" />
    @if (Model.ErrorMessage is not null)
    {
        <h4 style="color:red">@Model.ErrorMessage</h4>
    }
    <input type="submit" class="btn btn-outline-primary" value="Opslaan" />
    <a asp-page="/adminpage" asp-route-View="ManageBrands" class="btn btn-outline-danger">Terug</a>
</form>