@page
@model Gearwise.Pages.CreateCategoryModel
@{
}
<form method="post">
    <label for="CategoryName">Categorie naam:</label>
    <input type="text" id="CategoryName" name="name" />
    @if (Model.ErrorMessage is not null)
    {
        <h4 style="color:red">@Model.ErrorMessage</h4>
    }
    <input type="submit" class="btn btn-outline-primary" value="Opslaan" />
    <a asp-page="/adminpage" asp-route-View="ManageCategories" class="btn btn-outline-danger">Terug</a>
</form>